# Copy to .env and fill in. Never commit .env.

# Any OpenAI-compatible chat endpoint (Groq, Hugging Face router, OpenAI, a local server, ...)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# Salesforce (a free Developer Edition org works). Get the values with:
#   sf org display --target-org <alias> --json     (instanceUrl and accessToken)
SF_INSTANCE_URL=https://yourorg.my.salesforce.com
SF_ACCESS_TOKEN=
SF_API_VERSION=v60.0
